# Choose which LLM provider ragger uses: anthropic | openai | google | ollama
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=

# Only needed if LLM_PROVIDER=ollama and it's not on the default host
OLLAMA_HOST=http://localhost:11434

# Embedding model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where Chroma persists its data
CHROMA_PERSIST_DIR=./database/chroma

# Chroma collection name - give each fork of this template its own name
CHROMA_COLLECTION_NAME=ragger
